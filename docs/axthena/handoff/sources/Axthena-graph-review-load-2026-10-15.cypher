{`id`: "axhard-a-20261015/Report/H02", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H02", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H02", `name`: "H02", `published_on`: "2028-02-22", `first_supported_available_on`: "2028-02-23", `collected_on`: "2028-03-11", `available_on`: "2028-02-23", `source_type`: "PERSON", `source_id`: "person:leon", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[1]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H02", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H02", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H02", `name`: "H02 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[1]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H02.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H02.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H02.p1", `name`: "H02.p1", `position`: 1, `text`: "For the interval from 22 February 2028 to 7 March 2028, I prefer NovaChips shares to DragonLogic shares. The spread between the two AI-chip suppliers should move in NovaChips' favour. NovaChips has the cleaner delivery calendar in my assessment, whereas DragonLogic's customers have more opportunities to revise quantities before taking delivery. That difference gives the NovaChips side of a paired position a better starting point, even with both companies exposed to the same nervous spending committees.", `text_sha256`: "1b5da96e3fe19db96f40c561b1912ee6a304adfcf23ca1ef580431580baabac3", `input_path`: "$.reports[1].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H02.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H02.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H02.p2", `name`: "H02.p2", `position`: 2, `text`: "A broad retreat from semiconductor equities could still punish the position's long leg, and a sector rebound could lift its short leg. I would judge this recommendation by the difference between their returns. The attraction is that procurement timing may separate the two companies even when general market forces pull them together. I would keep the cash amounts balanced at inception and avoid treating the stronger company as immune to valuation pressure. The next delivery updates could change the size of the spread without resolving the direction of the overall market.", `text_sha256`: "570337472b36718e5e25f9d0248adb506472b298b8dd4fa089d930ce11c4ab40", `input_path`: "$.reports[1].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H02.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H02.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H02.1", `report_id`: "H02", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[1].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H02.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H02.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H02.1", `summary`: "Leon prefers NovaChips shares to DragonLogic shares from 22 February to 7 March 2028, expecting relative outperformance based on delivery timing without forecasting either stock's absolute direction.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[1].ideas[0]", `domain_state`: "EXTRACTED"}},
