{`id`: "axhard-a-20261015/Report/H09", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H09", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H09", `name`: "H09", `published_on`: "2028-03-31", `first_supported_available_on`: "2028-04-02", `collected_on`: "2028-04-19", `available_on`: "2028-04-02", `source_type`: "PERSON", `source_id`: "person:amara", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[8]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H09", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H09", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H09", `name`: "H09 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[8]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H09.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H09.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H09.p1", `name`: "H09.p1", `position`: 1, `text`: "NOVA's bounce after the close has drawn attention back to NovaChips, but the number I am watching is operating profit from its AI-chip business. I expect that profit to increase as the lower-cost Aurora configuration becomes a larger part of deliveries. The shares have already recovered much of their earlier loss, leaving valuation less forgiving. For now, the case I can make is for better operating economics as product mix changes; the market has already given that possibility a generous reception.", `text_sha256`: "1293457bc35d1f625881579fccfde9f02068d1e4c5e33ff043e8a783b8cb4daf", `input_path`: "$.reports[8].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Expression/H09.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H09.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H09.1", `report_id`: "H09", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[8].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H09.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H09.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H09.1", `summary`: "Amara expects NovaChips' AI-chip operating profit to increase as the lower-cost Aurora configuration grows as a share of deliveries, while observing that the share valuation already reflects generous expectations.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[8].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H09.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H09.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H09.1 evidence 1", `quote`: "NOVA's bounce after the close has drawn attention back to NovaChips, but the number I am watching is operating profit from its AI-chip business. I expect that profit to increase as the lower-cost Aurora configuration becomes a larger part of deliveries. The shares have already recovered much of their earlier loss, leaving valuation less forgiving. For now, the case I can make is for better operating economics as product mix changes; the market has already given that possibility a generous reception.", `paragraph_id`: "H09.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 504, `start_utf8_byte`: 0, `end_utf8_byte`: 504, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[8].ideas[0].evidence[0]"}},
