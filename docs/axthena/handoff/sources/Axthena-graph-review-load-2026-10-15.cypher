{`id`: "axhard-a-20261015/Report/H03", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H03", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H03", `name`: "H03", `published_on`: "2028-03-01", `first_supported_available_on`: "2028-03-02", `collected_on`: "2028-03-10", `available_on`: "2028-03-02", `source_type`: "COMPANY", `source_id`: "company:O4", `body_status`: "COMPLETE", `confirmation_scope`: ["ForgeFoundry signed operations notice: no unplanned shutdown occurred at the North fabrication plant on 29 February 2028; the recorded pause was scheduled instrument calibration."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[2]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H03", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H03", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H03", `name`: "H03 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[2]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H03.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H03.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H03.p1", `name`: "H03.p1", `position`: 1, `text`: "ForgeFoundry says no unplanned shutdown occurred at its North fabrication plant on 29 February 2028. A signed operations notice issued after questions from customers identifies the twelve-minute pause shown in a monitoring chart as scheduled instrument calibration. The chart circulated without its maintenance annotation, leading some recipients to read the blank segment as an outage. The company rejects that reading and says the calibration window was included in the operating schedule sent to customers before the shift began.", `text_sha256`: "84c5c387212a6c1b16a3445cfaa449c57f2ec44182740a15cc8d48fa3a89abab", `input_path`: "$.reports[2].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H03.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H03.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H03.p2", `name`: "H03.p2", `position`: 2, `text`: "The notice addresses the specific interval marked in the circulated chart. It explains that the monitoring display combines several signals and that a gap in one trace does not by itself establish that the fabrication line stopped unexpectedly. Customers had asked whether the unexplained gap represented a disruption requiring revised delivery estimates. ForgeFoundry's response is confined to the reported incident at the North plant. The company attached the relevant scheduled-maintenance entry to the notice so recipients could compare the timestamp against the segment that prompted their enquiries.", `text_sha256`: "c923f5f17aeefb6cd273d9ea417dc27a85a9a39785cbd96b1547c142d3e6421c", `input_path`: "$.reports[2].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H03.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H03.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H03.1", `report_id`: "H03", `position`: 1, `kind`: "FACT", `event_phase`: "NONE", `output_path`: "$.reports[2].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H03.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H03.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H03.1", `summary`: "ForgeFoundry's signed operations notice says no unplanned shutdown occurred at its North fabrication plant on 29 February 2028; the chart's twelve-minute pause was scheduled instrument calibration.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[2].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H03.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H03.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H03.1 evidence 1", `quote`: "ForgeFoundry says no unplanned shutdown occurred at its North fabrication plant on 29 February 2028. A signed operations notice issued after questions from customers identifies the twelve-minute pause shown in a monitoring chart as scheduled instrument calibration.", `paragraph_id`: "H03.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 265, `start_utf8_byte`: 0, `end_utf8_byte`: 265, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[2].ideas[0].evidence[0]"}},
{`id`: "axhard-a-20261015/Source/outlet:platform-ledger", `type`: "Source", `properties`: {`id`: "axhard-a-20261015/Source/outlet:platform-ledger", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `source_id`: "outlet:platform-ledger", `name`: "outlet:platform-ledger", `source_type`: "OUTLET", `origin`: "SUPPLIED_FIXTURE_SOURCE_ID"}},
{`id`: "axhard-a-20261015/Report/H04", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H04", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H04", `name`: "H04", `published_on`: "2028-05-31", `first_supported_available_on`: "2028-06-03", `collected_on`: "2028-06-12", `available_on`: "2028-06-03", `source_type`: "OUTLET", `source_id`: "outlet:platform-ledger", `body_status`: "COMPLETE", `confirmation_scope`: ["NovaCloud signed customer notice dated 31 May 2028 announces a plan to retire the legacy administration console on 30 June 2028, conditional on completion of customer migration checks."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[3]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H04", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H04", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H04", `name`: "H04 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[3]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H04.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H04.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H04.p1", `name`: "H04.p1", `position`: 1, `text`: "NovaCloud has announced plans to retire its legacy administration console on 30 June, according to a signed customer notice dated 31 May 2028. The cloud-software subsidiary of NovaChips says the retirement date remains dependent on completion of customer migration checks. Administrators are being asked to test their existing permission settings in the replacement interface before the final switch. The notice describes the intended change and the checks required to proceed; customers can continue using the legacy console while those checks are completed.", `text_sha256`: "7dddcacfb0545fc0abb837e9b6528bf9e485996bcd04351db48c3c0f763e7b77", `input_path`: "$.reports[3].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H04.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H04.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H04.p2", `name`: "H04.p2", `position`: 2, `text`: "The proposed switch would bring billing controls and workspace permissions into the same interface, reducing the number of screens administrators need to visit. For teams with customised permission groups, the notice recommends comparing access lists before accepting the migration. NovaCloud will use those checks to determine whether the planned retirement can go ahead on the stated date. The document gives customers a contact route for reporting discrepancies and says unresolved migration issues will be assessed before the legacy interface is withdrawn.", `text_sha256`: "1bacd118b958d6b8c78cacf9af31bfeabf7f0e4e19f509b463816321e53e2449", `input_path`: "$.reports[3].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H04.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H04.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H04.1", `report_id`: "H04", `position`: 1, `kind`: "CONFIRMED_NEWS", `event_phase`: "ANNOUNCEMENT", `output_path`: "$.reports[3].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H04.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H04.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H04.1", `summary`: "NovaCloud announced a plan to retire its legacy administration console on 30 June 2028, conditional on completing customer migration checks; the notice confirms the plan, not completion of the retirement.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[3].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H04.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H04.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H04.1 evidence 1", `quote`: "NovaCloud has announced plans to retire its legacy administration console on 30 June, according to a signed customer notice dated 31 May 2028. The cloud-software subsidiary of NovaChips says the retirement date remains dependent on completion of customer migration checks.", `paragraph_id`: "H04.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 272, `start_utf8_byte`: 0, `end_utf8_byte`: 272, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[3].ideas[0].evidence[0]"}},
{`id`: "axhard-a-20261015/Source/person:amara", `type`: "Source", `properties`: {`id`: "axhard-a-20261015/Source/person:amara", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `source_id`: "person:amara", `name`: "person:amara", `source_type`: "PERSON", `origin`: "SUPPLIED_FIXTURE_SOURCE_ID"}},
{`id`: "axhard-a-20261015/Person/person:amara", `type`: "Person", `properties`: {`id`: "axhard-a-20261015/Person/person:amara", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `source_id`: "person:amara", `name`: "person:amara", `identity_scope`: "SOURCE_ID_ONLY; real-world identity not established"}},
{`id`: "axhard-a-20261015/Report/H05", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H05", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H05", `name`: "H05", `published_on`: "2028-02-20", `first_supported_available_on`: "2028-02-22", `collected_on`: "2028-03-09", `available_on`: "2028-02-22", `source_type`: "PERSON", `source_id`: "person:amara", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[4]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H05", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H05", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H05", `name`: "H05 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[4]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H05.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H05.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H05.p1", `name`: "H05.p1", `position`: 1, `text`: "NOVA's seven per cent rise last week has made the shares harder for me to own. I expect NovaChips shares to fall over the next two weeks, because the enthusiasm around its Aurora AI-chip demonstration has moved faster than my assessment of near-term customer demand. The demonstration may have improved perceptions of engineering quality, but I think the price now assumes buyers will commit to large configurations before they have finished their own performance checks. That is a demanding assumption after such a sharp weekly gain.", `text_sha256`: "6b68779a7ca13a9076f9e0e61134a11fd78a9d016838c6720b572f97198b762f", `input_path`: "$.reports[4].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H05.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H05.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H05.p2", `name`: "H05.p2", `position`: 2, `text`: "My concern is the valuation attached to the demonstration, rather than a claim that the hardware failed. An impressive benchmark can justify another customer evaluation without immediately justifying the full deployment budget. Investors who bought ahead of the event have already received a substantial price response, leaving less room for another favourable surprise at the same stage of evaluation. I would reduce exposure at these levels and wait for a better relationship between the share price and the commercial evidence. The recent rally is why I see downside from here.", `text_sha256`: "d67fa0f38e016c1495955700d69aa0508d9857ac403b116fa7a0c65459a00b29", `input_path`: "$.reports[4].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H05.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H05.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H05.1", `report_id`: "H05", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[4].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "HAS_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H05.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H05.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H05.1", `summary`: "Amara expects NovaChips shares to fall over the next two weeks, judging enthusiasm and valuation after the Aurora AI-chip demonstration to have moved ahead of near-term customer demand.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[4].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Judgment/H05.1.j1", `type`: "Judgment", `properties`: {`id`: "axhard-a-20261015/Judgment/H05.1.j1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "NOVA DOWN", `stock`: "NOVA", `direction`: "DOWN", `window_state`: "RELATIVE", `start`: "2028-02-20", `end`: "2028-03-05", `position`: 1, `output_path`: "$.reports[4].ideas[0].judgments[0]", `qualification_location`: "PARENT_IDEA_SUMMARY_AND_EVIDENCE", `end_boundary`: "EXCLUSIVE_TRIAL_CONVENTION"}},
{`id`: "axhard-a-20261015/Passage/H05.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H05.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H05.1 evidence 1", `quote`: "I expect NovaChips shares to fall over the next two weeks, because the enthusiasm around its Aurora AI-chip demonstration has moved faster than my assessment of near-term customer demand.", `paragraph_id`: "H05.p1", `position`: 1, `start_codepoint`: 79, `end_codepoint`: 266, `start_utf8_byte`: 79, `end_utf8_byte`: 266, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[4].ideas[0].evidence[0]"}},
{`id`: "axhard-a-20261015/Source/outlet:supply-journal", `type`: "Source", `properties`: {`id`: "axhard-a-20261015/Source/outlet:supply-journal", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `source_id`: "outlet:supply-journal", `name`: "outlet:supply-journal", `source_type`: "OUTLET", `origin`: "SUPPLIED_FIXTURE_SOURCE_ID"}},
{`id`: "axhard-a-20261015/Report/H06", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H06", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H06", `name`: "H06", `published_on`: "2028-04-30", `first_supported_available_on`: "2028-05-02", `collected_on`: "2028-05-15", `available_on`: "2028-05-02", `source_type`: "OUTLET", `source_id`: "outlet:supply-journal", `body_status`: "COMPLETE", `confirmation_scope`: ["Ridge Materials completed dispatch of the first commercial lot of RM-8 packaging solvent on 29 April 2028, supported by its signed dispatch manifest and customer receipt."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[5]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H06", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H06", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H06", `name`: "H06 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[5]", `retained_idea_count`: 2}},
{`id`: "axhard-a-20261015/Paragraph/H06.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H06.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H06.p1", `name`: "H06.p1", `position`: 1, `text`: "Ridge Materials dispatched the first commercial lot of its RM-8 packaging solvent on 29 April, according to the company's signed manifest and a customer receipt reviewed by Supply Journal. The shipment marks the move from sample quantities to a commercial lot for the new materials formulation. The documents identify the product, dispatch date and receiving customer, and record acceptance of the delivered lot. They contain no agreement for additional volumes. For the producer, the shipment is a completed delivery after a testing programme in which customers had received much smaller quantities.", `text_sha256`: "e15bcb6e15e133f0c1c29137f0baea82a061d201deb43826c45a0b6cbbdc3ea9", `input_path`: "$.reports[5].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H06.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H06.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H06.p2", `name`: "H06.p2", `position`: 2, `text`: "DragonLogic, meanwhile, may revise the package used for its D8 AI chip before the next design freeze, two people familiar with supplier discussions said. They described the revision as an option still being assessed, with neither a final selection nor a purchase order in place. One person said engineers were comparing alternatives for handling heat within the package. DragonLogic declined to comment on the discussions. The people did not identify Ridge Materials as a participant or say that RM-8 was among the materials under consideration.", `text_sha256`: "f23a7084e871ab323654a8c99d0c943091f1cc93fe0fddd93f074f7788796404", `input_path`: "$.reports[5].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H06.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H06.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H06.1", `report_id`: "H06", `position`: 1, `kind`: "CONFIRMED_NEWS", `event_phase`: "OCCURRED", `output_path`: "$.reports[5].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H06.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H06.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H06.1", `summary`: "Ridge Materials completed dispatch of the first commercial RM-8 packaging-solvent lot on 29 April 2028, supported by its signed manifest and a customer receipt.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[5].ideas[0]", `domain_state`: "EXTRACTED"}},
