{`id`: "axhard-a-20261015/Judgment/H12.1.j1", `type`: "Judgment", `properties`: {`id`: "axhard-a-20261015/Judgment/H12.1.j1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "NOVA UP", `stock`: "NOVA", `direction`: "UP", `window_state`: "EXPLICIT", `start`: "2028-02-29", `end`: "2028-03-14", `position`: 1, `output_path`: "$.reports[11].ideas[0].judgments[0]", `qualification_location`: "PARENT_IDEA_SUMMARY_AND_EVIDENCE", `end_boundary`: "EXCLUSIVE_TRIAL_CONVENTION"}},
{`id`: "axhard-a-20261015/Passage/H12.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H12.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H12.1 evidence 1", `quote`: "My forecast is that NOVA shares will rise from 29 February 2028 to 14 March 2028. The opening auction has repeatedly found buyers above the previous closing price, and sellers have struggled to extend the late-session declines. I think that pattern leaves the balance of short-term trading pressure pointed upward over the stated interval. I would size the position around the recent trading range, since a break below it would weaken this market-based argument.", `paragraph_id`: "H12.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 462, `start_utf8_byte`: 0, `end_utf8_byte`: 462, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[11].ideas[0].evidence[0]"}},
