{`id`: "axhard-a-20261015/Report/H01", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H01", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H01", `name`: "H01", `published_on`: "2027-12-24", `first_supported_available_on`: "2027-12-26", `collected_on`: "2028-01-05", `available_on`: "2027-12-26", `source_type`: "PERSON", `source_id`: "person:selene", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[0]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H01", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H01", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H01", `name`: "H01 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[0]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H01.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H01.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H01.p1", `name`: "H01.p1", `position`: 1, `text`: "NovaChips enters the holiday break with a valuation that leaves little room for another delay in its Vela AI-chip programme. My positive trade depends on a narrow hurdle: if the two remaining customers sign their acceptance certificates by 28 December, I expect NOVA shares to rise over the next two weeks. A provisional engineering sign-off would not satisfy that hurdle. The certificates must cover commercial acceptance, because that is the point at which the deferred payment schedule becomes useful to the equity story.", `text_sha256`: "06bb7658fa1672ee4233390e638ddac01d1dc07dcb2c206833efa546afdfd7f9", `input_path`: "$.reports[0].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H01.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H01.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H01.p2", `name`: "H01.p2", `position`: 2, `text`: "The distinction matters after a quarter in which prototype demonstrations drew enthusiastic coverage but failed to settle buyers' procurement questions. I see the current discount as compensation for that unresolved acceptance risk. Clearing it could bring valuation back toward the range investors previously paid for delivered systems. Until the certificates appear, my position would remain small; attractive performance charts alone would not make me add. The customer deadline is close enough to affect this trade, while the eventual scale of the Vela installed base remains a separate uncertainty.", `text_sha256`: "4305b16ae5a6040c04a1920765c396cd022e4efa579077627687ba4faeef344f", `input_path`: "$.reports[0].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H01.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H01.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H01.1", `report_id`: "H01", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[0].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "HAS_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H01.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H01.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H01.1", `summary`: "Selene expects NOVA shares to rise over the next two weeks only if both remaining Vela AI-chip customers sign commercial acceptance certificates by 28 December; provisional engineering sign-off would not meet the condition.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[0].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Judgment/H01.1.j1", `type`: "Judgment", `properties`: {`id`: "axhard-a-20261015/Judgment/H01.1.j1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "NOVA UP", `stock`: "NOVA", `direction`: "UP", `window_state`: "RELATIVE", `start`: "2027-12-24", `end`: "2028-01-07", `position`: 1, `output_path`: "$.reports[0].ideas[0].judgments[0]", `qualification_location`: "PARENT_IDEA_SUMMARY_AND_EVIDENCE", `end_boundary`: "EXCLUSIVE_TRIAL_CONVENTION"}},
{`id`: "axhard-a-20261015/Passage/H01.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H01.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H01.1 evidence 1", `quote`: "My positive trade depends on a narrow hurdle: if the two remaining customers sign their acceptance certificates by 28 December, I expect NOVA shares to rise over the next two weeks. A provisional engineering sign-off would not satisfy that hurdle. The certificates must cover commercial acceptance, because that is the point at which the deferred payment schedule becomes useful to the equity story.", `paragraph_id`: "H01.p1", `position`: 1, `start_codepoint`: 125, `end_codepoint`: 524, `start_utf8_byte`: 125, `end_utf8_byte`: 524, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[0].ideas[0].evidence[0]"}},
