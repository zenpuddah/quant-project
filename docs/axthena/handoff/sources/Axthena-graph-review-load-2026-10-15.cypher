{`id`: "axhard-a-20261015/Report/H13", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H13", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H13", `name`: "H13", `published_on`: "2026-10-01", `first_supported_available_on`: "2026-10-01", `collected_on`: "2026-10-15", `available_on`: "2026-10-01", `source_type`: "OUTLET", `source_id`: "outlet:harbour-ledger", `body_status`: "COMPLETE", `confirmation_scope`: ["NovaChips and DragonLogic issued the signed announcement on 1 October 2026 of their agreement for NovaChips to acquire DragonLogic's Kestrel AI-chip design business for 240 million credits; the announcement makes completion conditional on a specified customer consent and describes 14 October as the expected closing date. No completed acquisition is confirmed."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[12]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H13", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H13", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H13", `name`: "H13 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[12]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H13.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H13.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H13.p1", `name`: "H13.p1", `position`: 1, `text`: "NovaChips has announced an agreement to buy DragonLogic's Kestrel AI-chip design business for 240 million credits, putting a smaller accelerator team at the centre of its next product cycle. The companies' joint statement sets 14 October as the expected closing date. Completion remains subject to consent from the business's largest customer, and the purchase price will be paid when ownership transfers.", `text_sha256`: "4405cc3843c778a52b1b8feb4e1e253b6ed17e3eea7c9eaea51a36cdea22e547", `input_path`: "$.reports[12].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H13.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H13.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H13.p2", `name`: "H13.p2", `position`: 2, `text`: "The proposed sale covers the Kestrel design files, associated patents and the engineering team assigned to that product. DragonLogic's other AI-chip programmes remain outside the agreement. Employees will continue reporting to DragonLogic until closing; NovaChips will nominate the unit's management once the transfer takes effect. The statement describes a transitional licensing arrangement intended to let existing customer projects continue without replacing their software interfaces.", `text_sha256`: "13bf0f39bcf461c8521d8939f789e6285b2720eee494696fac8ed5030e4c1d11", `input_path`: "$.reports[12].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Paragraph/H13.p3", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H13.p3", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H13.p3", `name`: "H13.p3", `position`: 3, `text`: "The deal follows several months of discussions over the future of the smaller design unit. Kestrel's office is across the road from a NovaCloud support centre, although that cloud-software subsidiary has no role in the purchase. A date for the customer-consent decision was not supplied. Both companies directed questions about the expected timetable to the conditions in their joint statement.", `text_sha256`: "a80527bad9c0817d664c9bbef2d665ea182ca6f259fcc20c4a0acc5277b03b7d", `input_path`: "$.reports[12].paragraphs[2]"}},
{`id`: "axhard-a-20261015/Expression/H13.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H13.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H13.1", `report_id`: "H13", `position`: 1, `kind`: "CONFIRMED_NEWS", `event_phase`: "ANNOUNCEMENT", `output_path`: "$.reports[12].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H13.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H13.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H13.1", `summary`: "NovaChips and DragonLogic announced an agreement for NovaChips to acquire DragonLogic's Kestrel AI-chip design business for 240 million credits. Closing was expected on 14 October 2026, subject to the largest customer's consent; completion was not confirmed.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[12].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H13.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H13.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H13.1 evidence 1", `quote`: "NovaChips has announced an agreement to buy DragonLogic's Kestrel AI-chip design business for 240 million credits, putting a smaller accelerator team at the centre of its next product cycle. The companies' joint statement sets 14 October as the expected closing date. Completion remains subject to consent from the business's largest customer, and the purchase price will be paid when ownership transfers.", `paragraph_id`: "H13.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 405, `start_utf8_byte`: 0, `end_utf8_byte`: 405, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[12].ideas[0].evidence[0]"}},
