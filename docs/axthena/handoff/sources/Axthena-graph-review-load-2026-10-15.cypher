{`id`: "axhard-a-20261015/ProcessingRecord/H33", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H33", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H33", `name`: "H33 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[32]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H33.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H33.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H33.p1", `name`: "H33.p1", `position`: 1, `text`: "夜间版更正：DragonLogic的人工智能芯片生产线没有停工。早版配图中的空车间属于尚未启用的另一层楼，不能说明现有产线已经停止运行。本刊撤下了原先的停工标题，并保留更正记录。目前没有公司签署的运行公告随文提供；这则更正是本刊对自身报道的修订。正文没有讨论股价，也未列出新的生产计划。", `text_sha256`: "e66bb3540409bc8dccf72fc06f5b9a0259c8731ef24a6a179eeca1bee6de7a99", `input_path`: "$.reports[32].paragraphs[0]"}},
