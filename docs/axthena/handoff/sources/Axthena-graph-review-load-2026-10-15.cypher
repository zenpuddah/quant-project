{`id`: "axhard-a-20261015/Passage/H10.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H10.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H10.1 evidence 1", `quote`: "Ridge Materials released BatchLens version 1.0 to customers today, 30 June 2028. The standalone software tool compares laboratory test files and highlights fields that differ between batches. Its signed release record lists the delivered installer and user guide.", `paragraph_id`: "H10.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 263, `start_utf8_byte`: 0, `end_utf8_byte`: 263, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[9].ideas[0].evidence[0]"}},
{`id`: "axhard-a-20261015/Report/H11", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H11", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H11", `name`: "H11", `published_on`: "2028-08-31", `first_supported_available_on`: "2028-09-03", `collected_on`: "2028-09-20", `available_on`: "2028-09-03", `source_type`: "PERSON", `source_id`: "person:leon", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[10]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H11", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H11", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H11", `name`: "H11 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[10]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H11.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H11.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H11.p1", `name`: "H11.p1", `position`: 1, `text`: "I expect NOVA shares to fall as investors mark down what they will pay for NovaChips' AI-chip backlog. The order book looks impressive in unit terms, but my concern is the margin investors attach to those units. Customers appear more interested in the basic configuration than in the expensive options that carry the most attractive economics. I would need a more conservative valuation before adding to my holding, even if the headline order total continues to attract favourable coverage.", `text_sha256`: "fc63776116166901f81a906cb1ad8693d4b6e53bbfd5856a516ee89872ee1f0c", `input_path`: "$.reports[10].paragraphs[0]"}},
