{`id`: "axhard-a-20261015/Idea/H21.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H21.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H21.1", `summary`: "Sel expects NOVA to outperform DRAG from 1 November to 1 December 2026, citing NovaChips' more balanced AI-chip customer list and DragonLogic's reliance on a delayed project. This is a relative view without an absolute stock-price direction; the sector could lose value if customers tighten capital budgets.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[20].ideas[0]", `domain_state`: "EXTRACTED"}},
