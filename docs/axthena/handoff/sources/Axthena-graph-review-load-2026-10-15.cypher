{`id`: "axhard-a-20261015/Passage/H06.2.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H06.2.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H06.2 evidence 1", `quote`: "DragonLogic, meanwhile, may revise the package used for its D8 AI chip before the next design freeze, two people familiar with supplier discussions said. They described the revision as an option still being assessed, with neither a final selection nor a purchase order in place.", `paragraph_id`: "H06.p2", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 278, `start_utf8_byte`: 0, `end_utf8_byte`: 278, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[5].ideas[1].evidence[0]"}},
