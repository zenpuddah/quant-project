{`id`: "axhard-a-20261015/Judgment/H11.1.j1", `type`: "Judgment", `properties`: {`id`: "axhard-a-20261015/Judgment/H11.1.j1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "NOVA DOWN", `stock`: "NOVA", `direction`: "DOWN", `window_state`: "MISSING", `start`: null, `end`: null, `position`: 1, `output_path`: "$.reports[10].ideas[0].judgments[0]", `qualification_location`: "PARENT_IDEA_SUMMARY_AND_EVIDENCE", `end_boundary`: "EXCLUSIVE_TRIAL_CONVENTION"}},
