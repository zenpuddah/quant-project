{`id`: "axhard-a-20261015/ProcessingRecord/H35", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H35", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H35", `name`: "H35 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[34]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H35.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H35.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H35.p1", `name`: "H35.p1", `position`: 1, `text`: "NovaChips与ForgeFoundry可能为一款人工智能芯片签订合作协议。两家公司尚未公布签字文件，项目页面也没有列出正式启动日期。本刊目前掌握的内容只涉及仍待敲定的合作安排，产品外形与量产数量都未写入公开资料。网页上的共同展台照片拍摄于旧活动，不能据此判断协议已经生效。报道暂未涉及任何股票价格判断。", `text_sha256`: "60241fd8ab768f9f28247e1964ccd273d8a5eb13bcc9fbfebad32a17e272f0d2", `input_path`: "$.reports[34].paragraphs[0]"}},
