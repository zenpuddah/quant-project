{`id`: "axhard-a-20261015/Idea/H24.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H24.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H24.1", `summary`: "NovaCloud announced on 9 October 2026 a plan to open a limited customer trial of its Harbor cloud-software budgeting service on 2 November. The announcement and planned date are confirmed, while the future opening is not confirmed.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[23].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H24.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H24.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H24.1 evidence 1", `quote`: "NovaCloud announced plans to open a limited customer trial of Harbor, its cloud-software budgeting service, on 2 November.", `paragraph_id`: "H24.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 122, `start_utf8_byte`: 0, `end_utf8_byte`: 122, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[23].ideas[0].evidence[0]"}},
