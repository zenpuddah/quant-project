{`id`: "axhard-a-20261015/Report/H18", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H18", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H18", `name`: "H18", `published_on`: "2026-10-14", `first_supported_available_on`: "2026-10-14", `collected_on`: "2026-10-16", `available_on`: "2026-10-14", `source_type`: "OUTLET", `source_id`: "outlet:west-quay-monitor", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[17]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H18", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H18", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H18", `name`: "H18 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[17]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H18.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H18.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H18.p1", `name`: "H18.p1", `position`: 1, `text`: "DragonLogic began commercial production of its D6 AI chips at its own pilot plant on 14 October, two people familiar with the site told the West Quay Monitor. They said the first customer batch entered the line during the morning shift and that workers were using production travellers rather than the documents used for engineering samples. DragonLogic did not respond to the Monitor's request for comment before publication.", `text_sha256`: "b46b86a0884dd7ea6fee7d9e8c9ef804192060d60e354d52de719f0f044fdc76", `input_path`: "$.reports[17].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H18.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H18.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H18.p2", `name`: "H18.p2", `position`: 2, `text`: "The people described a small initial run using equipment already installed in the pilot hall. They said the batch was intended for a paying customer, but neither supplied an order number or a copy of the production ledger. The Monitor has not seen a shipment notice. The reported start would therefore concern manufacturing at the plant, rather than delivery of finished chips to the customer.", `text_sha256`: "fee8c7619ada6eeb21bfe9496478b5f9d83856e03e747b1e8428faf72f0fef6c", `input_path`: "$.reports[17].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Paragraph/H18.p3", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H18.p3", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H18.p3", `name`: "H18.p3", `position`: 3, `text`: "D6 engineering samples have previously been made in the same hall, where staff can move between testing and manufacturing assignments. The people said the change was visible in the work instructions issued that morning. Their account concerns the commercial status of the 14 October batch; the scale of any later production programme was not established.", `text_sha256`: "70870d0890aa4cd4c1396fdf049b046cce75f651ce6102390a4deccfba54f1c7", `input_path`: "$.reports[17].paragraphs[2]"}},
{`id`: "axhard-a-20261015/Expression/H18.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H18.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H18.1", `report_id`: "H18", `position`: 1, `kind`: "RUMOURED_NEWS", `event_phase`: "OCCURRED", `output_path`: "$.reports[17].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H18.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H18.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H18.1", `summary`: "Two unnamed sources claim DragonLogic began commercial production of D6 AI chips at its own pilot plant on 14 October 2026. The account concerns manufacturing, not delivery, and lacks company confirmation, a supplied production ledger, or a shipment notice.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[17].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H18.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H18.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H18.1 evidence 1", `quote`: "DragonLogic began commercial production of its D6 AI chips at its own pilot plant on 14 October, two people familiar with the site told the West Quay Monitor.", `paragraph_id`: "H18.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 158, `start_utf8_byte`: 0, `end_utf8_byte`: 158, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[17].ideas[0].evidence[0]"}},
{`id`: "axhard-a-20261015/Passage/H18.1.e2", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H18.1.e2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H18.1 evidence 2", `quote`: "They said the batch was intended for a paying customer, but neither supplied an order number or a copy of the production ledger. The Monitor has not seen a shipment notice. The reported start would therefore concern manufacturing at the plant, rather than delivery of finished chips to the customer.", `paragraph_id`: "H18.p2", `position`: 2, `start_codepoint`: 94, `end_codepoint`: 393, `start_utf8_byte`: 94, `end_utf8_byte`: 393, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[17].ideas[0].evidence[1]"}},
{`id`: "axhard-a-20261015/Source/company:O2", `type`: "Source", `properties`: {`id`: "axhard-a-20261015/Source/company:O2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `source_id`: "company:O2", `name`: "company:O2", `source_type`: "COMPANY", `origin`: "SUPPLIED_FIXTURE_SOURCE_ID"}},
{`id`: "axhard-a-20261015/Report/H19", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H19", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H19", `name`: "H19", `published_on`: "2026-10-15", `first_supported_available_on`: "2026-10-15", `collected_on`: "2026-10-16", `available_on`: "2026-10-15", `source_type`: "COMPANY", `source_id`: "company:O2", `body_status`: "COMPLETE", `confirmation_scope`: ["DragonLogic's signed plant notice confirms that, as of the end of 14 October 2026, commercial D6 AI-chip production had not begun at its pilot plant; every D6 wafer processed there that day was an engineering sample and no D6 customer production order had been opened."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[18]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H19", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H19", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H19", `name`: "H19 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[18]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H19.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H19.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H19.p1", `name`: "H19.p1", `position`: 1, `text`: "Commercial production of DragonLogic's D6 AI chips had not begun at our pilot plant by the end of 14 October. All D6 wafers processed that day were engineering samples, and no customer production order had been opened. A report describing a first paying-customer batch is incorrect. Staff used revised work instructions for an engineering qualification exercise. Those documents did not change the status of the wafers or authorise customer production.", `text_sha256`: "309240a16e08f0791d699f71e2a7a837fd7284f321401963527b01c3493666da", `input_path`: "$.reports[18].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Expression/H19.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H19.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H19.1", `report_id`: "H19", `position`: 1, `kind`: "FACT", `event_phase`: "NONE", `output_path`: "$.reports[18].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H19.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H19.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H19.1", `summary`: "DragonLogic confirms that commercial D6 AI-chip production had not begun at its pilot plant by the end of 14 October 2026. Every D6 wafer processed that day was an engineering sample, and no customer production order had been opened.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[18].ideas[0]", `domain_state`: "EXTRACTED"}},
