{`id`: "axhard-a-20261015/Idea/H33.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H33.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H33.1", `summary`: "The outlet corrects its earlier report and states that DragonLogic's AI-chip production line did not stop operating; the empty workshop image depicted a different, unused floor. No qualifying company confirmation is supplied.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[32].ideas[0]", `domain_state`: "EXTRACTED"}},
