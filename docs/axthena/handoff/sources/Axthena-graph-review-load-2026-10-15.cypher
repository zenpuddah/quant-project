{`id`: "axhard-a-20261015/Expression/H06.2", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H06.2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H06.2", `report_id`: "H06", `position`: 2, `kind`: "RUMOURED_NEWS", `event_phase`: "POTENTIAL", `output_path`: "$.reports[5].ideas[1]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "NO_RETAINED_UP_DOWN"}},
