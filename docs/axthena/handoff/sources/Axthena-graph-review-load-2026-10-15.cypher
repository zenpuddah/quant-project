{`id`: "axhard-a-20261015/ProcessingRecord/H08", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H08", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H08", `name`: "H08 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[7]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H08.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H08.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H08.p1", `name`: "H08.p1", `position`: 1, `text`: "If Helix awards its accelerator contract to NovaChips by 28 December, I expect NOVA to gain and DRAG to decline over the interval from 29 December 2027 to 12 January 2028. The procurement would shift a contested AI-chip order toward NovaChips at DragonLogic's expense. Helix could still postpone its choice, which would leave my proposed trade without its trigger. I would require the signed award notice before opening either leg; reports that one bidder is merely ahead would not be enough.", `text_sha256`: "0f765a9bfd70be4800cfbd5441e7f2f412faf948a43a616b1cc9b566f1003386", `input_path`: "$.reports[7].paragraphs[0]"}},
