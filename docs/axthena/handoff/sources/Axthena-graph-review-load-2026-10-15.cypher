{`id`: "axhard-a-20261015/Idea/H23.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H23.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H23.1", `summary`: "Ridge Materials corrected its September 2026 wafer-cleaning solvent shipments to 480 tonnes, withdrawing the transposed 840-tonne figure. The total covers its own shipments to all customers, not customer consumption or wafer output.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[22].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Passage/H23.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H23.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H23.1 evidence 1", `quote`: "Ridge Materials shipped 480 tonnes of wafer-cleaning solvent in September. Our initial dispatch summary printed 840 tonnes because two digits were transposed; the signed correction replaces that figure with 480 throughout the table. The total covers deliveries to all customers.", `paragraph_id`: "H23.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 278, `start_utf8_byte`: 0, `end_utf8_byte`: 278, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[22].ideas[0].evidence[0]"}},
