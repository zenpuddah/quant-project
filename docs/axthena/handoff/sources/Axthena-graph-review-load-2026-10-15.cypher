{`id`: "axhard-a-20261015/ProcessingRecord/H22", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H22", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H22", `name`: "H22 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[21]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H22.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H22.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H22.p1", `name`: "H22.p1", `position`: 1, `text`: "I expect NOVA's share price to decline. NovaChips' latest AI-chip design looks capable, but I think the company will need more production revisions before customers are comfortable placing large orders. Each revision makes it harder to defend the margin assumptions behind my old bullish view. The product could eventually succeed, yet I no longer think technical promise is enough to support the shares at this stage.", `text_sha256`: "6ca8635a9fb0dc8fbd0f61d2611a977ae4e9677b1884e721a875eb9ff063870e", `input_path`: "$.reports[21].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Expression/H22.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H22.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H22.1", `report_id`: "H22", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[21].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "HAS_RETAINED_UP_DOWN"}},
{`id`: "axhard-a-20261015/Idea/H22.1", `type`: "Idea", `properties`: {`id`: "axhard-a-20261015/Idea/H22.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H22.1", `summary`: "Tovan expects NOVA's share price to decline, without specifying a forecast period, because further AI-chip production revisions may be needed before customers place large orders and undermine the margin assumptions behind the earlier bullish view.", `identity_scope`: "REPORT_LOCAL_SINGLETON", `output_path`: "$.reports[21].ideas[0]", `domain_state`: "EXTRACTED"}},
{`id`: "axhard-a-20261015/Judgment/H22.1.j1", `type`: "Judgment", `properties`: {`id`: "axhard-a-20261015/Judgment/H22.1.j1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "NOVA DOWN", `stock`: "NOVA", `direction`: "DOWN", `window_state`: "MISSING", `start`: null, `end`: null, `position`: 1, `output_path`: "$.reports[21].ideas[0].judgments[0]", `qualification_location`: "PARENT_IDEA_SUMMARY_AND_EVIDENCE", `end_boundary`: "EXCLUSIVE_TRIAL_CONVENTION"}},
{`id`: "axhard-a-20261015/Passage/H22.1.e1", `type`: "Passage", `properties`: {`id`: "axhard-a-20261015/Passage/H22.1.e1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H22.1 evidence 1", `quote`: "I expect NOVA's share price to decline. NovaChips' latest AI-chip design looks capable, but I think the company will need more production revisions before customers are comfortable placing large orders. Each revision makes it harder to defend the margin assumptions behind my old bullish view.", `paragraph_id`: "H22.p1", `position`: 1, `start_codepoint`: 0, `end_codepoint`: 293, `start_utf8_byte`: 0, `end_utf8_byte`: 293, `offset_convention`: "ZERO_BASED_END_EXCLUSIVE", `output_path`: "$.reports[21].ideas[0].evidence[0]"}},
{`id`: "axhard-a-20261015/Report/H23", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H23", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H23", `name`: "H23", `published_on`: "2026-10-12", `first_supported_available_on`: "2026-10-12", `collected_on`: "2026-10-15", `available_on`: "2026-10-12", `source_type`: "COMPANY", `source_id`: "company:O5", `body_status`: "COMPLETE", `confirmation_scope`: ["Ridge Materials' signed correction confirms that it shipped 480 tonnes of wafer-cleaning solvent in September 2026. The 840-tonne figure in the initial dispatch summary was a transposition error and is withdrawn. The 480 tonnes cover Ridge Materials' own total shipments, not any customer's output."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[22]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H23", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H23", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H23", `name`: "H23 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[22]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H23.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H23.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H23.p1", `name`: "H23.p1", `position`: 1, `text`: "Ridge Materials shipped 480 tonnes of wafer-cleaning solvent in September. Our initial dispatch summary printed 840 tonnes because two digits were transposed; the signed correction replaces that figure with 480 throughout the table. The total covers deliveries to all customers. ForgeFoundry is one customer listed in the accompanying directory, which is unchanged. Customer consumption and wafer output are recorded in customers' own operating reports and are outside this dispatch summary.", `text_sha256`: "e84bc08d7d47ebe1fd6f9ac60bc60229120b26b66c9087bddf5e87e1a6f3d424", `input_path`: "$.reports[22].paragraphs[0]"}},
