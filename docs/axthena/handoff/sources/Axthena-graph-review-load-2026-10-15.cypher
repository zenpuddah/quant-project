{`id`: "axhard-a-20261015/Report/H17", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H17", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H17", `name`: "H17", `published_on`: "2026-10-15", `first_supported_available_on`: "2026-10-15", `collected_on`: "2026-10-18", `available_on`: "2026-10-15", `source_type`: "PERSON", `source_id`: "person:leni", `body_status`: "COMPLETE", `confirmation_scope`: [], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[16]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H17", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H17", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H17", `name`: "H17 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[16]", `retained_idea_count`: 2}},
{`id`: "axhard-a-20261015/Paragraph/H17.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H17.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H17.p1", `name`: "H17.p1", `position`: 1, `text`: "I expect NovaChips shares to rise from 20 October to 3 November 2026 if the N7 AI chip receives its scheduled customer certification on 19 October. Certification would let customers release purchase orders that are already budgeted, and I think that change would support a higher share price during the stated interval. My forecast depends on that approval arriving on schedule. A delayed decision would leave me without the same basis for taking the position, even if the technical team remained confident.", `text_sha256`: "544c9590c2d840bdb25c9cbc5bbd1012b248a8d2d19ce5512bba40509eec9298", `input_path`: "$.reports[16].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Paragraph/H17.p2", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H17.p2", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H17.p2", `name`: "H17.p2", `position`: 2, `text`: "DragonLogic presents a separate concern. I expect DRAG shares to fall over the next ten days because its new AI-chip board still needs a cooling revision before the largest customer can accept deliveries. The delay matters to my view because it postpones the point at which finished inventory can generate cash. I would not treat a demonstration with a temporary cooling rig as evidence that the customer has accepted the production board. This is a view about DragonLogic's own delivery problem, which I would hold even if the NovaChips certification decision went smoothly.", `text_sha256`: "6c334b4f0e4bcea4d6a8ece9fa45436f85ceb79c9926a2c4ad111d3939d1906f", `input_path`: "$.reports[16].paragraphs[1]"}},
{`id`: "axhard-a-20261015/Expression/H17.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H17.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H17.1", `report_id`: "H17", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[16].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "HAS_RETAINED_UP_DOWN"}},
