{`id`: "axhard-a-20261015/Report/H20", `type`: "Report", `properties`: {`id`: "axhard-a-20261015/Report/H20", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H20", `name`: "H20", `published_on`: "2026-10-11", `first_supported_available_on`: "2026-10-12", `collected_on`: "2026-10-15", `available_on`: "2026-10-12", `source_type`: "OUTLET", `source_id`: "outlet:cloud-register", `body_status`: "COMPLETE", `confirmation_scope`: ["NovaCloud's signed service bulletin confirms that its Relay cloud-software workload scheduler became generally available to paying customers on 11 October 2026, after a limited trial; it also confirms that existing trial users can continue on the general service."], `confirmation_scope_basis`: "SUPPLIED_INPUT; not independently verified", `input_file`: "evidence/input.json", `input_path`: "$.reports[19]", `original_url`: null, `original_url_status`: "FICTIONAL_NO_URL"}},
{`id`: "axhard-a-20261015/ProcessingRecord/H20", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H20", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H20", `name`: "H20 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[19]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H20.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H20.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H20.p1", `name`: "H20.p1", `position`: 1, `text`: "NovaCloud made its Relay cloud-software workload scheduler generally available to paying customers on 11 October, its signed service bulletin says. The launch follows a limited trial, and participating customers can continue using their existing accounts. NovaCloud, a subsidiary of NovaChips, operates and bills for Relay itself. The service places customer workloads in available cloud capacity and lets administrators set spending limits. Support requests will continue through NovaCloud's existing customer portal.", `text_sha256`: "705cc34a8a9755f620a98efdfee04fa5d681fb5cb698730414cd8b74b471ab29", `input_path`: "$.reports[19].paragraphs[0]"}},
