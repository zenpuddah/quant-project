{`id`: "axhard-a-20261015/Paragraph/H07.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H07.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H07.p1", `name`: "H07.p1", `position`: 1, `text`: "I no longer expect DragonLogic shares to fall over the next two weeks. The revised delivery sequence for its D7 AI chip makes another disappointment less likely in my assessment, and I have closed the position built around that downside view. A sustained rally would still require firmer orders than I currently see. At this valuation I am comfortable standing aside while customers work through their evaluations, rather than reversing the old position immediately.", `text_sha256`: "7a120164570616bc7f939500be76a592207ebe8d47fc5ee7e5ca674034eb39db", `input_path`: "$.reports[6].paragraphs[0]"}},
