{`id`: "axhard-a-20261015/ProcessingRecord/H10", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H10", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H10", `name`: "H10 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[9]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H10.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H10.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H10.p1", `name`: "H10.p1", `position`: 1, `text`: "Ridge Materials released BatchLens version 1.0 to customers today, 30 June 2028. The standalone software tool compares laboratory test files and highlights fields that differ between batches. Its signed release record lists the delivered installer and user guide. Customers can load their existing files without purchasing a new materials formulation. The application was developed to reduce the time technicians spend checking spreadsheets before a review, and the released version runs against files stored on the customer's own workstation.", `text_sha256`: "f2a43909df2a54e940a4a29b3c34bc6ca9a8229bdb4027d45d70f8bf14c6469b", `input_path`: "$.reports[9].paragraphs[0]"}},
