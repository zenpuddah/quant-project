{`id`: "axhard-a-20261015/ProcessingRecord/H34", `type`: "ProcessingRecord", `properties`: {`id`: "axhard-a-20261015/ProcessingRecord/H34", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `report_id`: "H34", `name`: "H34 processing", `processing_status`: "COMPLETE", `cap_omitted`: false, `output_file`: "evidence/combined_output_A.json", `output_path`: "$.reports[33]", `retained_idea_count`: 1}},
{`id`: "axhard-a-20261015/Paragraph/H34.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H34.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H34.p1", `name`: "H34.p1", `position`: 1, `text`: "Je m’attends à une hausse de NovaChips en Bourse, portée par sa puce d’IA N5. Les outils de diagnostic associés au produit me semblent plus faciles à adopter que la génération précédente. C’est surtout la manière dont ils rendent les erreurs visibles qui retient mon attention : un utilisateur peut comprendre le problème sans parcourir plusieurs écrans. Cette facilité compte davantage dans mon appréciation que la couleur du boîtier ou la mise en scène du lancement. Elle nourrit mon opinion favorable sur le titre.", `text_sha256`: "56555e9a65e1ce22de25a36c78ed88f2a37dace2a413470785a912451ee47bf3", `input_path`: "$.reports[33].paragraphs[0]"}},
