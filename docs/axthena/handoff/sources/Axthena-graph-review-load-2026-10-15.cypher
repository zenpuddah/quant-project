{`id`: "axhard-a-20261015/Paragraph/H12.p1", `type`: "Paragraph", `properties`: {`id`: "axhard-a-20261015/Paragraph/H12.p1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `paragraph_id`: "H12.p1", `name`: "H12.p1", `position`: 1, `text`: "My forecast is that NOVA shares will rise from 29 February 2028 to 14 March 2028. The opening auction has repeatedly found buyers above the previous closing price, and sellers have struggled to extend the late-session declines. I think that pattern leaves the balance of short-term trading pressure pointed upward over the stated interval. I would size the position around the recent trading range, since a break below it would weaken this market-based argument.", `text_sha256`: "4b3cbbbde4cba0cbd79bb356ea663b40b5fc1d14cc4d701228234af687e46fec", `input_path`: "$.reports[11].paragraphs[0]"}},
{`id`: "axhard-a-20261015/Expression/H12.1", `type`: "Expression", `properties`: {`id`: "axhard-a-20261015/Expression/H12.1", `fixture_id`: "axhard-a-20261015", `data_status`: "FICTIONAL", `name`: "H12.1", `report_id`: "H12", `position`: 1, `kind`: "OPINION", `event_phase`: "NONE", `output_path`: "$.reports[11].ideas[0]", `output_file`: "evidence/combined_output_A.json", `judgment_status`: "HAS_RETAINED_UP_DOWN"}},
